# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# All are optional — the studio works offline without them; they unlock cloud AI generation.
ELEVENLABS_API_KEY=        # voiceover / SFX / music generation
OPENAI_API_KEY=            # Whisper API fallback, image generation
FAL_KEY=                   # fal.ai: image-to-video (Kling, Veo, Wan, Seedance...), image gen
REPLICATE_API_TOKEN=       # alternative model host
HEYGEN_API_KEY=            # HyperFrames cloud render / TTS (optional)
