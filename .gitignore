# Dependencies & environments
node_modules/
.venv/
.venv-*/
venv/
env/
__pycache__/
*.pyc

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials/
secrets/

# Heavy media & outputs (track via docs, not git)
renders/
tmp/
productions/*/renders/
productions/*/cache/
assets/footage/*
assets/music/*
assets/sfx/*
assets/voice/*
assets/images/*
!assets/**/.gitkeep
*.mp4
*.mov
*.webm
*.wav
*.mp3
*.m4a
!tests/fixtures/**

# Model weights & formats
models/
*.bin
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt
*.gguf

# Local AI caches
.cache/
.huggingface/

# Local databases & logs
*.sqlite
*.sqlite3
*.db
*.log

# Third-party tools, avatar lab (personal references & outputs) & local-only scripts
tools/
avatar-lab/
scripts/avatar/

# OS / editor / tool state
.DS_Store
.remotion/
out/
.hyperframes/
