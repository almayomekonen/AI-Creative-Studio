  "concept": {
    "logline": "A watch ad cut entirely to the tick of its own second hand \u2014 the edit is the movement.",
    "bigIdea": "Count / clock: precision expressed as rhythm. The music is built from ticks; every cut lands on a second.",
    "hook": "Frame 0: an extreme macro of the red second hand mid-tick, shallow focus, on a white world; VO and type say 'Every second has a beat.' Instantly legible and rhythmic.",
    "progression": "Escalation of tempo: one tick \u2192 a giant 60 \u2192 a one-word-per-second life montage \u2192 the watch revealed whole \u2192 a sudden black moment where the second hand dissolves into 'Now.' \u2192 lockup on white.",
    "ending": "Contrast + callback: from the only black scene back to white, the hand keeps ticking under the logo; final tick lands on the last frame.",
    "audience": "28\u201350, design-literate professionals; watches on mute often \u2014 type carries the message.",
    "routes": [
      {
        "name": "The Edit Is the Movement",
        "idea": "Cut every shot on the tick; build the score from ticks.",
        "why": "Product truth (precision) becomes the film's form; very ownable; Swiss grid identity.",
        "risk": "Could feel cold \u2014 counter with the human montage words and one dramatic black 'Now.' moment."
      },
      {
        "name": "Time Lapse Life",
        "idea": "A day compressed into 20 s around the wrist.",
        "why": "Relatable.",
        "risk": "Needs people/locations \u2014 not producible procedurally. Killed."
      },
      {
        "name": "Swiss Grid Cathedral",
        "idea": "The watch as architecture; camera flies through the movement.",
        "why": "Spectacle.",
        "risk": "Requires an internal mechanism model we don't have yet \u2014 logged for the roadmap."
      }
    ],
    "chosen": "The Edit Is the Movement",
    "rationale": "Form = message; strongest originality; fully producible; the black 'Now.' contrast beat gives the progression a turn.",
    "scores": {
      "hook": 4,
      "originality": 5,
      "progression": 4,
      "transitions": 4,
      "ending": 4,
      "producibility": 5
    }
  },
