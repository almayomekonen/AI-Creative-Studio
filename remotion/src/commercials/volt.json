  "concept": {
    "logline": "The sound of a can opening is a portal: one crack and the night fills with voltage.",
    "bigIdea": "Sensory translation \u2014 the CRACK becomes a doorway into pure energy.",
    "hook": "Extreme macro of the ring-pull in total darkness; on beat 2 the word CRACK. slams with sparks and a flash. Works sound-off (sparks + slam) and sound-on (the crack hit).",
    "progression": "Journey: through the opening \u2192 a voltage tunnel \u2192 energy condenses from a lightning bolt into the brand name \u2192 rhythm montage \u2192 the can lands like a meteor \u2192 logo.",
    "ending": "Button: logo lockup, then a final spark burst on the last beat as the VO says the line \u2014 a callback to the opening crack.",
    "audience": "18\u201330, nightlife, gamers, students; watches with sound on, scrolls fast.",
    "routes": [
      {
        "name": "Crack Portal",
        "idea": "The ring-pull crack opens a portal into a voltage tunnel; energy assembles the logo.",
        "why": "Turns the single most recognisable product sound into the whole film; strong hook; showcases portal/particles/neon.",
        "risk": "Tunnel could read as generic sci-fi \u2014 keep the palette strictly acid lime + magenta and cut on beats."
      },
      {
        "name": "Night Shift Meter",
        "idea": "A battery meter UI drains as the night goes on; each sip recharges the world.",
        "why": "Clear benefit story.",
        "risk": "UI-heavy, looks like an app ad; weaker visual spectacle. Killed."
      },
      {
        "name": "Silent Club",
        "idea": "A club in total silence until the can opens and sound+light floods back.",
        "why": "Great contrast idea.",
        "risk": "Needs people and a real location \u2014 not producible honestly with a procedural stack. Killed."
      }
    ],
    "chosen": "Crack Portal",
    "rationale": "Highest hook + transition potential, 100% producible, the product truth (the jolt of opening) is the spine of every scene.",
    "scores": {
      "hook": 5,
      "originality": 4,
      "progression": 4,
      "transitions": 5,
      "ending": 4,
      "producibility": 5
    }
  },
